@startuml
title I2CIP Architecture

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

package "I2CIP Namespace" {
  enum i2cip_errorlevel_t {
    I2CIP_ERR_NONE
    I2CIP_ERR_SOFT
    I2CIP_ERR_HARD
  }

  enum i2cip_state_pin_t {
    PIN_OFF
    PIN_ON
    PIN_UNDEF
  }

  object RuntimeAPI {
    +commandRouter(command: JsonObject, out: Print): void
    +rebuildTree(out: Print, update: bool=false): void
    --
    {static} devicetree: BST<i2cip_fqa_t, Device*>
    {static} modules: Module*[8]
    {static} errlev: i2cip_errorlevel_t[8]
  }
}

package "Addressing and Bus Control" {
  object FQA {
    +createFQA(wire, mux, bus, addr): i2cip_fqa_t
    +beginWire(wire): bool
    +fqaToString(fqa): String
    --
    {static} wires: TwoWire*[1..2]
    {static} wiresBegun: bool[]
  }

  object MUX {
    +pingMUX(fqa): bool
    +pingMUX(wire, module): bool
    +setBus(fqa): i2cip_errorlevel_t
    +setBus(wire, module, bus): i2cip_errorlevel_t
    +resetBus(fqa): i2cip_errorlevel_t
    +resetBus(wire, module): i2cip_errorlevel_t
  }
}

package "Core Device Model" {
  class InputGetter {
    +get(args: void*): i2cip_errorlevel_t
    +failGet(): i2cip_errorlevel_t
    +getLastRX(): unsigned long
    +cacheToString(): const char*
  }

  class OutputSetter {
    +set(value: void*, args: void*): i2cip_errorlevel_t
    +reset(args: void*): i2cip_errorlevel_t
    +failSet(value: void*): i2cip_errorlevel_t
    +getLastTX(): unsigned long
    +valueToString(): const char*
  }

  class Device {
    -fqa: i2cip_fqa_t
    -id: i2cip_id_t
    -timeout: uint16_t
    -ready: bool
    -input: InputGetter*
    -output: OutputSetter*
    --
    +get(args: void*): i2cip_errorlevel_t
    +set(value: void*, args: void*): i2cip_errorlevel_t
    +ping(resetbus: bool=true, setbus: bool=true): i2cip_errorlevel_t
    +pingTimeout(setbus: bool=true, resetbus: bool=true): i2cip_errorlevel_t
    +read/write register helpers...
  }

  class "InputInterface<G,A>" as InputInterface {
    -cache: G
    -argsA: A
    +get(args: void*): i2cip_errorlevel_t
    +getCache(): const G&
    +get(dest: G&, args: A): i2cip_errorlevel_t
  }

  class "OutputInterface<S,B>" as OutputInterface {
    -value: S
    -argsB: B
    +set(value: void*, args: void*): i2cip_errorlevel_t
    +getValue(): S
    +set(value: S, args: B): i2cip_errorlevel_t
    +resetFailsafe(): void
  }

  class "IOInterface<G,A,S,B>" as IOInterface

  class EEPROM {
    -readBuffer: char[257]
    {static} _failsafe_set: bool
    {static} _failsafe: char[256]
    {static} _failsafe_b: uint16_t
    --
    +readContents(...): i2cip_errorlevel_t
    +overwriteContents(...): i2cip_errorlevel_t
    +clearContents(...): i2cip_errorlevel_t
    +get(dest: char*&, args: uint16_t): i2cip_errorlevel_t
    +set(value: const char* const&, args: uint16_t): i2cip_errorlevel_t
  }
}

package "Topology and Grouping" {
  class "BST<K,T>" as BST {
    +root: BSTNode<K,T>*
    +insert(key: K, value: T, overwrite: bool=true): BSTNode<K,T>*
    +remove(key: K): BSTNode<K,T>*
    +find(key: K): BSTNode<K,T>*
    +operator[](key: K): T*
    +size(): uint16_t
  }

  class "BSTNode<K,T>" as BSTNode {
    +key: K
    +value: T
    +left: BSTNode<K,T>*
    +right: BSTNode<K,T>*
  }

  class "HashTable<T>" as HashTable {
    -hashtable: HashTableEntry<T>*[16]
    -owns: bool
    +set(key: const char*, value: T*, overwrite: bool=true): HashTableEntry<T>*
    +get(key: const char*): HashTableEntry<T>*
    +operator[](key: const char*): T*
    +remove(key: const char*): bool
    +keys(): String*
  }

  class "HashTableEntry<T>" as HashTableEntry {
    +key: const char*
    +value: T*
    +next: HashTableEntry<T>*
    +owns: bool
  }

  class DeviceGroup {
    -key: i2cip_id_t
    -numdevices: uint8_t
    -devices: Device*[8]
    +factory: factory_device_t
    +handler: jsonhandler_device_t
    +cleanup: cleanup_device_t
    --
    +create<C>(id: i2cip_id_t): DeviceGroup*
    +operator[](fqa: i2cip_fqa_t): Device*
    +operator()(fqa: i2cip_fqa_t): Device*
  }

  class Module {
    -wire: uint8_t
    -mux: uint8_t
    -devicegroups: HashTable<DeviceGroup>
    -eeprom_added: bool
    #eeprom: EEPROM*
    --
    +operator[](id: i2cip_id_t): DeviceGroup*
    +operator()(): i2cip_errorlevel_t
    +discoverEEPROM(recurse: bool=false): i2cip_errorlevel_t
    +parseEEPROMContents(contents: const char*): bool
    +toJSON(obj: JsonObject, pingFilter: bool=false): void
    +handleCommand(command: JsonObject, out: Print): void
    +handleConfig(config: JsonObject, out: Print): void
    +handleInterval(intervals: JsonObject, out: Print): void
    +handleEvent(event: JsonObject, out: Print): void
  }

  class JsonModule
  class NotAModule
  class _NullStream
}

InputInterface --|> InputGetter
OutputInterface --|> OutputSetter
IOInterface --|> InputInterface
IOInterface --|> OutputInterface
EEPROM --|> Device
EEPROM --|> IOInterface

JsonModule --|> Module
NotAModule --|> Module
_NullStream --|> Stream

BST *-- BSTNode
HashTable *-- HashTableEntry
RuntimeAPI o-- BST : devicetree
RuntimeAPI o-- Module : modules[0..7]
Module *-- EEPROM
Module *-- HashTable : DeviceGroup table
DeviceGroup o-- Device : devices[0..7]

Device ..> MUX : set/reset bus
Device ..> FQA : address segmentation
Module ..> Device : add/remove/operate
Module ..> DeviceGroup : find/create
RuntimeAPI ..> Module : command routing
RuntimeAPI ..> JsonModule : EEPROM JSON parsing implementation

note right of RuntimeAPI
Global orchestration state is owned
by namespace-level variables:
- devicetree
- modules[]
- errlev[]
end note

note right of FQA
FQA (Fully Qualified Address) is a packed 16-bit route key:
- wire segment (physical I2C controller index)
- module segment (MUX/module number)
- bus segment (MUX channel)
- addr segment (7-bit peripheral address)

createFQA() validates each segment before packing.
fqaToString() is primarily diagnostics/debug formatting.
end note

note right of MUX
MUX is the bus-path switch layer.

Primary responsibilities:
- ping switch presence
- set active downstream channel
- reset switch channel(s)

Fake MUX / fake bus values are intentionally supported
to model direct-wire devices that bypass multiplexing.
end note

note bottom of Device
Device is the transport-centric base class:
- Owns immutable FQA identity and logical device ID
- Exposes common read/write/register primitives
- Centralizes ping/readiness/recovery behavior
- Delegates typed I/O semantics to InputGetter/OutputSetter

State model:
ready=false after failures, then lazy re-begin on next operation.
end note

note right of InputGetter
Type-erased input endpoint used by Device::get().

failGet() routes through a sentinel argument to request
default/reset behavior from typed InputInterface<G,A>.
end note

note right of OutputSetter
Type-erased output endpoint used by Device::set().

reset()/failSet() use sentinel argument/value combinations
to invoke default/failsafe behavior in OutputInterface<S,B>.
end note

note bottom of InputInterface
InputInterface<G,A> adds typed caching and argument replay:
- cache stores last successful GET payload
- argsA stores last effective read arguments
- first-call default args supplied by getDefaultA()

Pattern: stateless transport + stateful typed interface.
end note

note bottom of OutputInterface
OutputInterface<S,B> adds typed output history:
- value stores last successful SET value
- argsB stores last effective write arguments
- getDefaultB()/resetFailsafe() define recovery defaults

This enables repeat-write and failsafe semantics.
end note

note right of EEPROM
EEPROM is both:
1) A normal I2CIP Device
2) A typed IOInterface<char*, uint16_t, const char*, uint16_t>

It is used as:
- module metadata source (JSON-ish config string)
- persistent key data store

Implementation performs bounded page writes and
pingTimeout() polling between writes for write-cycle completion.
end note

note bottom of Module
Module is the subnet orchestrator for one wire+MUX pair.

Core duties:
- validate subnet ownership for FQAs
- discover and parse EEPROM configuration
- manage DeviceGroups (ID -> factory + instances)
- execute command/config/event handlers
- serialize module state as JSON

The module always owns exactly one EEPROM endpoint.
end note

note right of DeviceGroup
DeviceGroup binds an ID string to:
- a device factory
- JSON argument parser/cleanup hooks
- up to I2CIP_DEVICES_PER_GROUP concrete instances

operator()(fqa):
lookup existing instance OR create via factory.
end note

note right of HashTable
HashTable<T> is optimized for embedded constraints:
- fixed slot count (HASHTABLE_SLOTS)
- separate chaining for collisions
- optional ownership/deletion semantics

Used by Module for ID-indexed DeviceGroup lookup.
end note

note right of BST
BST<i2cip_fqa_t, Device*> is the global fast-path index.

Why BST here:
- lightweight implementation
- deterministic key ordering
- no allocator-heavy STL dependencies

Maps unique FQA -> active Device instance.
end note

note left of JsonModule
JsonModule provides the reference implementation of
parseEEPROMContents() that deserializes EEPROM payload,
resolves DeviceGroups by ID, and materializes devices
into the global tree/module structures.
end note

note left of NotAModule
NotAModule is a compatibility façade for devices not
physically behind a real hardware module.

It preserves Module-based call patterns while using
fake MUX/bus addressing conventions.
end note

note as N_flow
Typical runtime flow (command by FQA):
1) RuntimeAPI::commandRouter()
2) Route to modules[m]
3) Module resolves/creates Device via DeviceGroup/BST
4) Device performs MUX setBus + transport operation
5) Interface layer updates typed cache/value state
6) Optional MUX reset and module error aggregation
end note

RuntimeAPI .. N_flow

@enduml